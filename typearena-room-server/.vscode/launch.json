{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TypeArena: debug server (solo test)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.ts",
      "runtimeArgs": ["--import", "tsx"],
      "env": { "MIN_PLAYERS": "1" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
